{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm: build-extension",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/context-broker/scripts/build-extension.ps1"
      ],
      "problemMatcher": ["$tsc"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Deploy Context Broker Extension to Active AntiGravity IDE",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/context-broker/scripts/install-to-vscode.ps1"
      ],
      "problemMatcher": []
    }
  ]
}
